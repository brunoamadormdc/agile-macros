PORT=4000
MONGODB_URI=mongodb://localhost:27017/app_counter
JWT_SECRET=change_me_to_a_long_random_secret
# Keep launch-only integrations disabled by default.
FREE_LAUNCH_MODE=true
PAYMENTS_ENABLED=false

# Application URLs and targets
CLIENT_URL=http://localhost:5173
WEEKLY_TARGET_KCAL=14000

# Email / password reset (optional; leave blank to disable delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# API limits
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=900000
